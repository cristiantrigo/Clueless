{
  "name": "Clueless Party",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Al crear el Codespace se instalan las dependencias, y cada vez que se abre
  // se levanta el servidor solo: desde el móvil no hay que escribir nada.
  "postCreateCommand": "npm install",
  "postAttachCommand": "bash .devcontainer/arrancar.sh",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Clueless Party",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  }
}
